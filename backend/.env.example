# Copy this file to backend/.env and fill in the values.
#
#   cp backend/.env.example backend/.env


# --------------------------------------------------------------------
# SEC EDGAR
# --------------------------------------------------------------------
# Required by the /api/sec and /api/companies endpoints. SEC's fair
# access policy requires a real contact address in the User-Agent, and
# rejects requests without one.
SEC_USER_AGENT=Your Name your.email@example.com


# --------------------------------------------------------------------
# Finnhub (live US market quotes)
# --------------------------------------------------------------------
# Primary source for current US equity quotes and the Finnhub
# WebSocket trade stream. When unset, get_quote() falls back to
# yfinance and the WebSocket does not connect. NSE/BSE always use
# yfinance. Free keys: https://finnhub.io/register
FINNHUB_API_KEY=your_finnhub_api_key_here

# Treat a streamed last-trade as stale after this many seconds.
# FINNHUB_WS_STALE_SECONDS=30


# --------------------------------------------------------------------
# Ollama (reasoning LLM)
# --------------------------------------------------------------------
OLLAMA_BASE_URL=http://localhost:11434

# qwen2.5:1.5b-instruct is ~1GB quantized and runs on CPU. Larger
# models give better answers but need the RAM/VRAM to match.
OLLAMA_MODEL=qwen2.5:1.5b-instruct

# Used only if the primary model fails to load (e.g. out of memory).
OLLAMA_FALLBACK_MODEL=qwen2.5:1.5b-instruct

# Must be larger than the prompt actually sent, or Ollama silently
# truncates it and most of the evidence never reaches the model. A
# top_k=5 prompt at chunk_size=1200 words is ~6900 words, which is
# well over 10k tokens once dense financial figures are tokenized.
# The 2048 default in ollama_client.py is far too small.
OLLAMA_NUM_CTX=16384


# --------------------------------------------------------------------
# Retrieval
# --------------------------------------------------------------------
RERANKER_MODEL=cross-encoder/ms-marco-MiniLM-L-6-v2


# --------------------------------------------------------------------
# Database
# --------------------------------------------------------------------
# Defaults to a local SQLite file under backend/data/ when unset.
# DATABASE_URL=sqlite:///./data/tao_fin.db
